# ==============================================================================
# MARKET DATA PROVIDER CONFIGURATION
# ==============================================================================
# Modo de provisión de datos de mercado (velas OHLCV y tickers):
# - 'database': Consulta directa a TimescaleDB (cuando el bot corre en el mismo servidor VPS)
# - 'api':      Consulta remota vía CryptoView REST API (cuando el bot corre en otro servidor o en PC)
DATA_SOURCE_MODE=api

# Configuración si DATA_SOURCE_MODE=database (Mismo servidor)
TIMESCALE_DATABASE_URL=postgresql://cryptoview:cryptoview_secure_pwd@timescaledb:5432/cryptoview_db

# Configuración si DATA_SOURCE_MODE=api (Servidor remoto o PC)
CRYPTOVIEW_API_URL=https://129-146-110-196.sslip.io
CRYPTOVIEW_API_KEY=your_cryptoview_api_secret_token

# ==============================================================================
# BOT INTERNAL DATABASE (Órdenes, bots, tranches, métricas)
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/criptobot

# KuCoin Sub-account API Credentials (Zero-Trust: No withdrawal permissions)
KUCOIN_API_KEY=your_subaccount_api_key
KUCOIN_API_SECRET=your_subaccount_api_secret
KUCOIN_API_PASSPHRASE=your_subaccount_api_passphrase

# Telegram Notifications (Proactive mobile alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Discord Notifications (Isolated channel alerts via Webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Server Settings
HOST=0.0.0.0
PORT=8000
SEED_DEMO_DATA=false

# CryptoView Central Data Engine (High-speed 24/7 TimescaleDB OHLCV & Tickers)
CRYPTOVIEW_API_URL=https://129-146-110-196.sslip.io
CRYPTOVIEW_API_KEY=aa0d07ca7079caf19492d0fc4a762c593b3e02e205c669ae60de5cbbd66979c2
