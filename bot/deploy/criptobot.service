[Unit]
Description=CriptoBot Institutional Quantitative Trading Engine & API
After=network.target postgresql.service tailscaled.service
Wants=postgresql.service tailscaled.service

[Service]
Type=simple
User=cripto
Group=cripto
WorkingDirectory=/opt/criptobot
EnvironmentFile=/opt/criptobot/.env
ExecStart=/opt/criptobot/.venv/bin/python -m uvicorn src.api.app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s

# Security Hardening (Zero-Trust)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
