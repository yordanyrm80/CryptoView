# ==============================================================================
# CRYPTOVIEW DATA ENGINE - CONFIGURACIÓN DEL SERVIDOR
# ==============================================================================

# 1. Base de Datos PostgreSQL 17 + TimescaleDB
POSTGRES_USER=cryptoview
POSTGRES_PASSWORD=cryptoview_db_secure_password_2026
POSTGRES_DB=cryptoview_db

# 2. Seguridad del Servidor
# Token que CryptoView enviará en la cabecera 'X-API-Key' para autorizar peticiones
API_SECRET_TOKEN=cryptoview_secret_token_seguro_2026

# Clave maestra para cifrar/descifrar las API Keys de los exchanges en la base de datos (AES-256)
ENCRYPTION_KEY=cryptoview_master_aes_encryption_key_2026_super_secure!

# 3. Parámetros del Motor de Ingestión
# El motor descarga exclusivamente velas de 1m. TimescaleDB precalcula 5m, 15m, 1h, 1d, etc.
COLLECTOR_SLEEP_SECONDS=20
